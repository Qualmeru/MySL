    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Body with the destination sign, windscreen and two headlights cut out. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M42,29 h24 a6,6 0 0 1 6,6 v32 a6,6 0 0 1 -6,6 h-24 a6,6 0 0 1 -6,-6 v-32 a6,6 0 0 1 6,-6 z
