        android:pathData="M42.5,73 h7 v4 a2,2 0 0 1 -2,2 h-3 a2,2 0 0 1 -2,-2 z
            M58.5,73 h7 v4 a2,2 0 0 1 -2,2 h-3 a2,2 0 0 1 -2,-2 z" />

